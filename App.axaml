<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Perseus.App"
             xmlns:local="using:Perseus"
             RequestedThemeVariant="Dark">
             <!-- This app is a dedicated dark security console - it does not follow the OS light/dark toggle. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />

        <!-- Primary action button: solid gold, sharp corners, no gradients. -->
        <Style Selector="Button">
            <Setter Property="Background" Value="#D4AF37" />
            <Setter Property="Foreground" Value="#050B14" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="BorderBrush" Value="#8A6A1F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E9C868" />
        </Style>

        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#B8922C" />
        </Style>

        <Style Selector="Button:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#4A4530" />
            <Setter Property="TextBlock.Foreground" Value="#7C8598" />
        </Style>

        <!-- Secondary / low-emphasis button variant used for row-level actions. -->
        <Style Selector="Button.subtle">
            <Setter Property="Background" Value="#141F30" />
            <Setter Property="Foreground" Value="#D4AF37" />
            <Setter Property="BorderBrush" Value="#2A3B54" />
        </Style>

        <Style Selector="Button.subtle:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1B2A40" />
        </Style>

        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Foreground" Value="#B9C6DC" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#152238" />
        </Style>

        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#D4AF37" />
        </Style>

        <Style Selector="ListBoxItem:selected">
            <Setter Property="Foreground" Value="#050B14" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style Selector="TabControl">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="TabItem">
            <Setter Property="Foreground" Value="#7C8AA5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="12,8" />
        </Style>

        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="#D4AF37" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="#0C1524" />
            <Setter Property="Foreground" Value="#F1F5FB" />
            <Setter Property="CaretBrush" Value="#D4AF37" />
            <Setter Property="BorderBrush" Value="#26385A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#D4AF37" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#0C1524" />
            <Setter Property="Foreground" Value="#F1F5FB" />
            <Setter Property="BorderBrush" Value="#26385A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="#D4AF37" />
            <Setter Property="Background" Value="#141F30" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>

        <Style Selector="Expander">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F3F4F6" />
        </Style>

        <!-- Uppercase, letter-spaced section labels - the recurring "console" typographic accent. -->
        <Style Selector="TextBlock.section-title">
            <Setter Property="Foreground" Value="#D4AF37" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="2" />
        </Style>

        <!-- Monospace numeric readouts - telemetry/metric styling. -->
        <Style Selector="TextBlock.metric">
            <Setter Property="FontFamily" Value="Consolas,Cascadia Mono,Courier New,monospace" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- Terminal-green log text. -->
        <Style Selector="TextBlock.neon">
            <Setter Property="Foreground" Value="#5DE29B" />
            <Setter Property="FontFamily" Value="Consolas,Cascadia Mono,Courier New,monospace" />
        </Style>

        <!-- AI Assistant chat bubbles - default is Claude's reply, .user modifies for the user's turn. -->
        <Style Selector="Border.chat-bubble">
            <Setter Property="Background" Value="#121C2E" />
            <Setter Property="BorderBrush" Value="#1E2B42" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style Selector="Border.chat-bubble.user">
            <Setter Property="Background" Value="#1E1A0C" />
            <Setter Property="BorderBrush" Value="#4A3D1A" />
        </Style>

        <Style Selector="TextBlock.chat-role">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1" />
            <Setter Property="Foreground" Value="#7C8AA5" />
        </Style>

        <Style Selector="TextBlock.chat-role.user">
            <Setter Property="Foreground" Value="#D4AF37" />
        </Style>
    </Application.Styles>
</Application>
