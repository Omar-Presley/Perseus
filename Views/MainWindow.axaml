<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Perseus.ViewModels"
        xmlns:models="using:Perseus.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="860"
        x:Class="Perseus.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Name="Root"
        Icon="/Assets/PerseusIcon.ico"
        Title="PERSEUS — Proactive Endpoint Review and Security Evaluation Utility Suite"
        Width="1320"
        Height="900"
        Background="#050B14">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="290,*" Margin="18">
        <Border Grid.Column="0" CornerRadius="14" Background="#0A1220" Padding="16" Margin="0,0,16,0" BorderBrush="#1C2B42" BorderThickness="1">
            <StackPanel Spacing="12">
                <Border CornerRadius="12" Background="#0D1626" Padding="16" BorderBrush="#3A3220" BorderThickness="1">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <Border Width="86" Height="110" CornerRadius="10" ClipToBounds="True">
                            <Image Source="/Assets/PerseusIcon.png" Stretch="Uniform" />
                        </Border>
                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                            <TextBlock Text="PERSEUS" FontSize="19" FontWeight="Bold" Foreground="#F8FAFC" LetterSpacing="4" HorizontalAlignment="Center" />
                            <TextBlock Text="PROACTIVE ENDPOINT REVIEW &amp; SECURITY EVALUATION UTILITY SUITE"
                                       FontSize="9.5" FontWeight="Medium" Foreground="#D4AF37" LetterSpacing="0.6"
                                       TextWrapping="Wrap" TextAlignment="Center" Opacity="0.92" />
                            <Border Background="#101B2E" CornerRadius="3" Padding="8,3" Margin="0,4,0,0">
                                <TextBlock Foreground="#7C8AA5" FontSize="10" FontWeight="Bold" LetterSpacing="1">
                                    <Run Text="AGENT: " /><Run Text="{Binding PlatformLabel}" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button Content="Run Full Audit" Command="{Binding RunFullAuditCommand}" HorizontalAlignment="Stretch" Margin="0,4,0,0" />
                <Button Content="Refresh Network" Command="{Binding RefreshNetworkCommand}" HorizontalAlignment="Stretch" Classes="subtle" />

                <Rectangle Height="1" Fill="#1C2B42" Margin="0,4" />

                <TextBlock Text="NAVIGATION" Classes="section-title" Margin="4,0,0,2" />
                <ListBox SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0" Padding="0">
                    <ListBoxItem>Dashboard</ListBoxItem>
                    <ListBoxItem>Findings</ListBoxItem>
                    <ListBoxItem>Network</ListBoxItem>
                    <ListBoxItem>Remediation</ListBoxItem>
                    <ListBoxItem>AI Assistant</ListBoxItem>
                    <ListBoxItem>Reports</ListBoxItem>
                    <ListBoxItem>Settings</ListBoxItem>
                    <ListBoxItem>About</ListBoxItem>
                </ListBox>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" CornerRadius="14" Background="#0A1220" Padding="22" BorderBrush="#1C2B42" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TabControl Grid.Row="0" SelectedIndex="{Binding SelectedTabIndex}" IsVisible="{Binding !IsBusy}">
                <TabItem Header="Dashboard">
                    <ScrollViewer>
                        <StackPanel Spacing="16">
                            <Border CornerRadius="10" Background="#121C2E" Padding="18" BorderBrush="#1E2B42" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Security Dashboard" FontSize="22" FontWeight="Bold" Foreground="#F5F7FA" />
                                    <TextBlock Text="{Binding StatusMessage}" Foreground="#8B9CB8" TextWrapping="Wrap" />
                                    <TextBlock Foreground="#5C6C87" FontSize="12">
                                        <Run Text="Last full scan: " /><Run Text="{Binding LastScanAt, StringFormat='{}{0:g}', TargetNullValue=Never}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Grid ColumnDefinitions="1.4*,0.9*" HorizontalAlignment="Stretch">
                                <Border Grid.Column="0" CornerRadius="10" Background="#D4AF37" Padding="18" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="OVERALL SECURITY SCORE" FontSize="11" FontWeight="Bold" LetterSpacing="1.5" Foreground="#3A2F0C" />
                                        <TextBlock Text="{Binding OverallScore}" Classes="metric" FontSize="46" Foreground="#161200" />
                                        <TextBlock Text="{Binding RiskLevel}" FontSize="16" FontWeight="Bold" LetterSpacing="2" Foreground="#2A2100" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" CornerRadius="10" Background="#121C2E" Padding="18" Margin="8,0,0,0" BorderBrush="#1E2B42" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="AUDIT MODULES" Classes="section-title" Margin="0,0,0,6" />
                                        <ItemsControl ItemsSource="{Binding AuditModules}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Foreground="#DCE4F0" Margin="0,3" TextWrapping="Wrap" FontSize="12.5" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto">
                                <Border Grid.Column="0" CornerRadius="10" Background="#121C2E" Padding="16" Margin="0,0,8,0" BorderBrush="#3A1F1F" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="CRITICAL" Classes="section-title" FontSize="10.5" Foreground="#F0817D" />
                                        <TextBlock Text="{Binding CriticalCount}" Classes="metric" FontSize="26" Foreground="#F87171" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" CornerRadius="10" Background="#121C2E" Padding="16" Margin="8,0,8,0" BorderBrush="#3A2C1F" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="HIGH" Classes="section-title" FontSize="10.5" Foreground="#FDBA74" />
                                        <TextBlock Text="{Binding HighCount}" Classes="metric" FontSize="26" Foreground="#FB923C" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" CornerRadius="10" Background="#121C2E" Padding="16" Margin="8,0,8,0" BorderBrush="#3A351F" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="MEDIUM" Classes="section-title" FontSize="10.5" Foreground="#FDE68A" />
                                        <TextBlock Text="{Binding MediumCount}" Classes="metric" FontSize="26" Foreground="#FBBF24" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" CornerRadius="10" Background="#121C2E" Padding="16" Margin="8,0,0,0" BorderBrush="#1F3A2A" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="LOW" Classes="section-title" FontSize="10.5" Foreground="#86EFAC" />
                                        <TextBlock Text="{Binding LowCount}" Classes="metric" FontSize="26" Foreground="#34D399" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="1.2*,*">
                                <Border Grid.Column="0" CornerRadius="10" Background="#121C2E" Padding="16" Margin="0,0,8,0" BorderBrush="#1E2B42" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="RISK BY CATEGORY" Classes="section-title" />
                                        <ItemsControl ItemsSource="{Binding CategoryBreakdown}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="120,*,50" Margin="0,4">
                                                        <TextBlock Grid.Column="0" Text="{Binding Category}" Foreground="#DCE4F0" VerticalAlignment="Center" FontSize="12.5" />
                                                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="40" Value="{Binding Deduction}" Height="8" VerticalAlignment="Center" Margin="8,0" />
                                                        <TextBlock Grid.Column="2" Text="{Binding FindingCount}" Classes="metric" Foreground="#7C8AA5" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12.5" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" CornerRadius="10" Background="#121C2E" Padding="16" Margin="8,0,0,0" BorderBrush="#1E2B42" BorderThickness="1">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="INVENTORY SNAPSHOT" Classes="section-title" Margin="0,0,0,4" />
                                        <TextBlock Foreground="#DCE4F0" FontSize="13">
                                            <Run Text="Software scanned: " /><Run Text="{Binding SoftwareInventory.Count}" Classes="metric" />
                                        </TextBlock>
                                        <TextBlock Foreground="#DCE4F0" FontSize="13">
                                            <Run Text="CVE findings: " /><Run Text="{Binding CveFindingCount}" Classes="metric" />
                                        </TextBlock>
                                        <Button Content="Review Upgrades" Command="{Binding GoToRemediationCommand}" Classes="subtle" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border CornerRadius="10" Background="#121C2E" Padding="16" BorderBrush="#1E2B42" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="TOP RISKS" Classes="section-title" />
                                    <ItemsControl ItemsSource="{Binding TopFindings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,6" Padding="10" CornerRadius="6" Background="#0D1626">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#F5F7FA" FontSize="13" />
                                                        <TextBlock Foreground="#7C8AA5" FontSize="11.5">
                                                            <Run Text="{Binding Category}" /><Run Text=" - " /><Run Text="{Binding Severity}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Findings">
                    <ScrollViewer>
                        <StackPanel Spacing="12">
                            <Border CornerRadius="10" Background="#121C2E" Padding="12" BorderBrush="#1E2B42" BorderThickness="1">
                                <Grid ColumnDefinitions="*,*,*,*">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="WARNINGS" Classes="section-title" FontSize="10.5" Foreground="#F0817D" />
                                        <TextBlock Text="{Binding WarningCount}" Classes="metric" FontSize="22" Foreground="#F87171" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="INFO" Classes="section-title" FontSize="10.5" Foreground="#93C5FD" />
                                        <TextBlock Text="{Binding InfoCount}" Classes="metric" FontSize="22" Foreground="#60A5FA" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="GOOD" Classes="section-title" FontSize="10.5" Foreground="#86EFAC" />
                                        <TextBlock Text="{Binding GoodCount}" Classes="metric" FontSize="22" Foreground="#34D399" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="TOTAL" Classes="section-title" FontSize="10.5" />
                                        <TextBlock Text="{Binding Findings.Count}" Classes="metric" FontSize="22" Foreground="#F5F7FA" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border CornerRadius="10" Background="#121C2E" Padding="12" BorderBrush="#1E2B42" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="FILTER AND SORT" Classes="section-title" />
                                    <WrapPanel>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Category" Foreground="#7C8AA5" FontSize="11" />
                                            <ComboBox ItemsSource="{Binding AvailableCategories}" SelectedItem="{Binding SelectedCategoryFilter}" MinWidth="140" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Severity" Foreground="#7C8AA5" FontSize="11" />
                                            <ComboBox ItemsSource="{Binding AvailableSeverities}" SelectedItem="{Binding SelectedSeverityFilter}" MinWidth="120" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Status" Foreground="#7C8AA5" FontSize="11" />
                                            <ComboBox ItemsSource="{Binding AvailableStatuses}" SelectedItem="{Binding SelectedStatusFilter}" MinWidth="120" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Sort by" Foreground="#7C8AA5" FontSize="11" />
                                            <ComboBox ItemsSource="{Binding SortModes}" SelectedItem="{Binding FindingsSortMode}" MinWidth="120" />
                                        </StackPanel>
                                        <StackPanel MinWidth="200">
                                            <TextBlock Text="Search" Foreground="#7C8AA5" FontSize="11" />
                                            <TextBox Text="{Binding FindingsSearchText}" PlaceholderText="Search name, category, detail..." />
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding FilteredFindings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="12" CornerRadius="8" Background="#121C2E" BorderBrush="#1E2B42" BorderThickness="1">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#F5F7FA" />
                                                <TextBlock Text="{Binding Category}" Foreground="#8B9CB8" FontSize="12.5" />
                                                <TextBlock Text="{Binding Severity}" Foreground="#D4AF37" FontWeight="SemiBold" FontSize="12.5" />
                                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="#C7D0E0" FontSize="12.5" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                                                    <Button Content="View in Remediation" Classes="subtle" IsVisible="{Binding IsCveRelated}" Command="{Binding DataContext.GoToRemediationCommand, ElementName=Root}" />
                                                    <Button Content="Ask AI" Command="{Binding DataContext.AskAiAboutFindingCommand, ElementName=Root}" CommandParameter="{Binding Finding}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border CornerRadius="10" Background="#121C2E" Padding="12" BorderBrush="#1E2B42" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="FINDINGS BY CATEGORY" Classes="section-title" />
                                    <ItemsControl ItemsSource="{Binding FindingGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Expander Margin="0,0,0,6">
                                                    <Expander.Header>
                                                        <TextBlock Foreground="#F5F7FA" FontSize="13">
                                                            <Run Text="{Binding Category}" /><Run Text=" (" /><Run Text="{Binding Count}" /><Run Text=")" />
                                                        </TextBlock>
                                                    </Expander.Header>
                                                    <ItemsControl ItemsSource="{Binding Items}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Margin="12,2" Foreground="#C7D0E0" FontSize="12.5" TextWrapping="Wrap">
                                                                    <Run Text="{Binding Name}" /><Run Text=" - " /><Run Text="{Binding Severity}" />
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Network">
                    <ScrollViewer>
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,*,*">
                                <Border Grid.Column="0" CornerRadius="10" Background="#121C2E" Padding="14" Margin="0,0,8,0" BorderBrush="#1E2B42" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="TOTAL PORTS" Classes="section-title" FontSize="10.5" />
                                        <TextBlock Text="{Binding TotalPortsCount}" Classes="metric" FontSize="24" Foreground="#F5F7FA" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" CornerRadius="10" Background="#121C2E" Padding="14" Margin="8,0,8,0" BorderBrush="#3A1F1F" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="RISKY PORTS" Classes="section-title" FontSize="10.5" Foreground="#F0817D" />
                                        <TextBlock Text="{Binding RiskyPortsCount}" Classes="metric" FontSize="24" Foreground="#F87171" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" CornerRadius="10" Background="#121C2E" Padding="14" Margin="8,0,0,0" BorderBrush="#1E2B42" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="DISTINCT PROCESSES" Classes="section-title" FontSize="10.5" />
                                        <TextBlock Text="{Binding DistinctProcessCount}" Classes="metric" FontSize="24" Foreground="#F5F7FA" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBox Text="{Binding NetworkFilterText}" PlaceholderText="Filter by port, process, or service..." />

                            <ItemsControl ItemsSource="{Binding FilteredListeningPorts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="12" CornerRadius="8" Background="#121C2E" BorderBrush="#1E2B42" BorderThickness="1">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Spacing="4">
                                                    <TextBlock Text="{Binding Port}" Classes="metric" FontSize="15" Foreground="#F5F7FA" />
                                                    <TextBlock Text="{Binding ProcessName}" Foreground="#C7D0E0" FontSize="12.5" />
                                                    <TextBlock Text="{Binding Pid}" Foreground="#7C8AA5" FontSize="12" />
                                                    <TextBlock Text="{Binding ServiceName}" Foreground="#7C8AA5" FontSize="12" />
                                                </StackPanel>
                                                <Border Grid.Column="1" IsVisible="{Binding IsRisky}" Background="#3A1414" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding RiskLabel}" Foreground="#FCA5A5" FontWeight="Bold" FontSize="11.5" LetterSpacing="0.5" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Remediation">
                    <ScrollViewer>
                        <StackPanel Spacing="14">
                            <Border CornerRadius="10" Background="#121C2E" Padding="18" BorderBrush="#3A3220" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Package Remediation" FontSize="20" FontWeight="Bold" Foreground="#F5F7FA" />
                                    <TextBlock Text="Scan for available OS/package upgrades and apply them via winget, apt, or Homebrew. This is the only action in Perseus that modifies your system - nothing runs without explicit confirmation." TextWrapping="Wrap" Foreground="#8B9CB8" FontSize="13" />
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                                        <Button Content="Scan for Upgrades" Command="{Binding ScanUpgradesCommand}" />
                                        <Button Content="Upgrade Selected" Command="{Binding UpgradeSelectedCommand}" Classes="subtle" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding UpgradeCandidates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="12" CornerRadius="8" Background="#121C2E" BorderBrush="#1E2B42" BorderThickness="1">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Foreground="#F5F7FA" FontWeight="Bold" FontSize="13.5">
                                                        <Run Text="{Binding Package.Name}" /><Run Text=" (" /><Run Text="{Binding Package.Source}" /><Run Text=")" />
                                                    </TextBlock>
                                                    <TextBlock Foreground="#7C8AA5" Classes="metric" FontSize="12">
                                                        <Run Text="{Binding Package.CurrentVersion}" /><Run Text=" -&gt; " /><Run Text="{Binding Package.AvailableVersion}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding StatusText}" Foreground="#D4AF37" FontSize="12" />
                                                </StackPanel>
                                                <ProgressBar Grid.Column="2" IsIndeterminate="True" IsVisible="{Binding IsInProgress}" Width="80" Height="6" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="AI Assistant">
                    <Grid RowDefinitions="Auto,*,Auto,Auto">
                        <Border Grid.Row="0" CornerRadius="10" Background="#121C2E" Padding="14" Margin="0,0,0,12" BorderBrush="#3A3220" BorderThickness="1" IsVisible="{Binding !HasAnthropicApiKey}">
                            <TextBlock Foreground="#D4AF37" TextWrapping="Wrap">
                                <Run Text="Add your Anthropic API key in the Settings tab to enable the AI Assistant." />
                            </TextBlock>
                        </Border>

                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding AssistantMessages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="chat-bubble" Classes.user="{Binding IsUser}">
                                            <StackPanel Spacing="4">
                                                <TextBlock Classes="chat-role" Classes.user="{Binding IsUser}" Text="{Binding Role}" />
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#DCE4F0" FontSize="13" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
                            <TextBox Grid.Column="0" Text="{Binding AssistantInputText}" AcceptsReturn="True" Height="70"
                                     PlaceholderText="Ask about a finding, or how to fix something..." VerticalContentAlignment="Top" />
                            <Button Grid.Column="1" Content="Send" Margin="10,0,0,0" VerticalAlignment="Bottom"
                                    Command="{Binding SendAssistantMessageCommand}"
                                    IsEnabled="{Binding !IsAssistantResponding}" />
                            <Button Grid.Column="2" Content="Clear Chat" Classes="subtle" Margin="10,0,0,0" VerticalAlignment="Bottom"
                                    Command="{Binding ClearAssistantChatCommand}" />
                        </Grid>

                        <TextBlock Grid.Row="3" Text="Advisory only - review commands before running them. Nothing here executes automatically." Foreground="#5C6C87" FontSize="11" Margin="0,8,0,0" />
                    </Grid>
                </TabItem>

                <TabItem Header="Reports">
                    <ScrollViewer>
                        <StackPanel Spacing="14">
                            <TextBlock Text="Report Generation" FontSize="20" FontWeight="Bold" Foreground="#F5F7FA" />
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#8B9CB8" />
                            <TextBlock Foreground="#7C8AA5">
                                <Run Text="Last audit score: " /><Run Text="{Binding OverallScore}" Classes="metric" /><Run Text=" (" /><Run Text="{Binding RiskLevel}" /><Run Text=")" />
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Content="Generate HTML" Command="{Binding GenerateHtmlReportCommand}" Classes="subtle" />
                                <Button Content="Generate JSON" Command="{Binding GenerateJsonReportCommand}" Classes="subtle" />
                                <Button Content="Generate CSV" Command="{Binding GenerateCsvReportCommand}" Classes="subtle" />
                                <Button Content="Generate Full Report Set" Command="{Binding GenerateFullReportSetCommand}" />
                                <Button Content="Open Reports Folder" Command="{Binding OpenReportsFolderCommand}" Classes="subtle" />
                            </StackPanel>

                            <Border CornerRadius="10" Background="#121C2E" Padding="12" BorderBrush="#1E2B42" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="REPORT HISTORY" Classes="section-title" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshReportsCommand}" Classes="subtle" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding ReportHistory}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,6" Padding="10" CornerRadius="6" Background="#0D1626">
                                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                                        <TextBlock Grid.Column="0" Text="{Binding FileName}" Foreground="#F5F7FA" FontSize="12.5" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Format}" Foreground="#7C8AA5" Margin="10,0" VerticalAlignment="Center" FontSize="12" />
                                                        <TextBlock Grid.Column="2" Text="{Binding SizeKb, StringFormat='{}{0} KB'}" Classes="metric" Foreground="#7C8AA5" Margin="10,0" VerticalAlignment="Center" FontSize="12" />
                                                        <Button Grid.Column="3" Content="Open" Classes="subtle" Command="{Binding DataContext.OpenReportCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Settings">
                    <ScrollViewer>
                        <StackPanel Spacing="14">
                            <TextBlock Text="Application Settings" FontSize="20" FontWeight="Bold" Foreground="#F5F7FA" />
                            <CheckBox Content="Enable CVE Lookup" IsChecked="{Binding EnableCveLookup}" />
                            <CheckBox Content="Generate HTML" IsChecked="{Binding GenerateHtml}" />
                            <CheckBox Content="Generate JSON" IsChecked="{Binding GenerateJson}" />
                            <CheckBox Content="Enable Parallel Audit" IsChecked="{Binding EnableParallelAudit}" />
                            <TextBlock Text="Report folder" Foreground="#8B9CB8" />
                            <TextBox Text="{Binding ReportFolder}" PlaceholderText="C:\reports" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Content="Browse" Command="{Binding BrowseReportsFolderCommand}" Classes="subtle" />
                            </StackPanel>

                            <Border CornerRadius="10" Background="#121C2E" Padding="14" BorderBrush="#1E2B42" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="AUDIT TUNING" Classes="section-title" />
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                                            <TextBlock Text="Max CVE Targets" Foreground="#7C8AA5" FontSize="11" />
                                            <TextBox Text="{Binding MaxCveTargets}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                            <TextBlock Text="NVD Lookup Delay (ms)" Foreground="#7C8AA5" FontSize="11" />
                                            <TextBox Text="{Binding NvdDelayMsSetting}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
                                            <TextBlock Text="Update Staleness Days" Foreground="#7C8AA5" FontSize="11" />
                                            <TextBox Text="{Binding UpdateStalenessDaysSetting}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                                            <TextBlock Text="Max Admin Accounts" Foreground="#7C8AA5" FontSize="11" />
                                            <TextBox Text="{Binding MaxAdminAccountsSetting}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                                            <TextBlock Text="NVD API Key" Foreground="#7C8AA5" FontSize="11" />
                                            <TextBox Text="{Binding NvdApiKeySetting}" PasswordChar="*" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border CornerRadius="10" Background="#121C2E" Padding="14" BorderBrush="#3A3220" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="AI ASSISTANT" Classes="section-title" />
                                    <TextBlock Text="Anthropic API Key" Foreground="#7C8AA5" FontSize="11" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Text="{Binding AnthropicApiKeySetting}" PasswordChar="*" PlaceholderText="sk-ant-..." />
                                        <Button Grid.Column="1" Content="Save API Key" Margin="10,0,0,0" Command="{Binding SaveAnthropicKeyCommand}" Classes="subtle" />
                                    </Grid>
                                    <TextBlock Text="Encrypted with Windows DPAPI on this machine." Foreground="#5C6C87" FontSize="10.5" />
                                </StackPanel>
                            </Border>

                            <Border CornerRadius="10" Background="#121C2E" Padding="14" BorderBrush="#1E2B42" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="RISKY PORTS" Classes="section-title" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="Add Port" Command="{Binding AddRiskyPortCommand}" Classes="subtle" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding RiskyPorts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="100,*,Auto" Margin="0,4">
                                                    <TextBox Grid.Column="0" Text="{Binding Port}" PlaceholderText="Port" />
                                                    <TextBox Grid.Column="1" Text="{Binding Label}" PlaceholderText="Label" Margin="8,0" />
                                                    <Button Grid.Column="2" Content="Remove" Classes="subtle" Command="{Binding DataContext.RemoveRiskyPortCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Content="Restore Defaults" Command="{Binding RestoreDefaultSettingsCommand}" Classes="subtle" />
                                <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="About">
                    <ScrollViewer>
                        <StackPanel Spacing="16">
                            <Border CornerRadius="10" Background="#121C2E" Padding="18" BorderBrush="#1E2B42" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="PERSEUS" FontSize="21" FontWeight="Bold" Foreground="#F5F7FA" LetterSpacing="3" />
                                    <TextBlock Text="Proactive Endpoint Review &amp; Security Evaluation Utility Suite" FontSize="13" FontWeight="SemiBold" Foreground="#D4AF37" TextWrapping="Wrap" />
                                    <TextBlock Text="Perseus reviews the security posture of this machine end to end. It inspects operating system hardening, accounts, network exposure, and installed software, then distills everything into a single risk score and severity breakdown you can act on immediately." TextWrapping="Wrap" Foreground="#DCE4F0" />
                                </StackPanel>
                            </Border>

                            <Border CornerRadius="10" Background="#121C2E" Padding="18" BorderBrush="#1E2B42" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="WHAT IT CHECKS" Classes="section-title" />
                                    <TextBlock TextWrapping="Wrap" Foreground="#DCE4F0">
                                        <Run Text="A full audit examines, for whichever operating system it's running on: " />
                                        <Run Text="firewall configuration and remote-access exposure (RDP, SSH, SMB); " FontWeight="SemiBold" />
                                        <Run Text="disk encryption status; " FontWeight="SemiBold" />
                                        <Run Text="user accounts and admin/privilege hygiene; " FontWeight="SemiBold" />
                                        <Run Text="persistence mechanisms such as startup entries and scheduled tasks; " FontWeight="SemiBold" />
                                        <Run Text="modern platform protections (Secure Boot, Credential Guard, Gatekeeper, SIP, and similar); " FontWeight="SemiBold" />
                                        <Run Text="and patch status and software inventory." FontWeight="SemiBold" />
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" Foreground="#DCE4F0">
                                        <Run Text="The Network tab separately inventories every listening port on the machine and flags the ones commonly associated with risk. Installed software is cross-referenced against public vulnerability data to surface any known CVEs." />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border CornerRadius="10" Background="#121C2E" Padding="18" BorderBrush="#1E2B42" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="GETTING FROM FINDING TO FIX" Classes="section-title" />
                                    <TextBlock TextWrapping="Wrap" Foreground="#DCE4F0" Text="Every finding can be handed to the AI Assistant, which explains the issue in plain language and gives step-by-step remediation guidance tailored to this operating system - it's advisory only and never runs anything on its own. Where a fix is simply an outdated package, the Remediation tab can apply the update directly through the operating system's own package manager, behind an explicit confirmation step so nothing changes on the machine without your say-so." />
                                    <TextBlock TextWrapping="Wrap" Foreground="#DCE4F0" Text="Results can be exported at any time as an HTML, JSON, or CSV report for sharing or record-keeping." />
                                </StackPanel>
                            </Border>

                            <Border CornerRadius="10" Background="#121C2E" Padding="18" BorderBrush="#1E2B42" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="GETTING STARTED" Classes="section-title" />
                                    <TextBlock TextWrapping="Wrap" Foreground="#8B9CB8" Text="Start with Run Full Audit, then review the Dashboard for an overview, dig into individual findings, check the Network tab for exposed ports, apply upgrades in Remediation, or export a report. Settings lets you tune what gets audited and where reports are saved." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                </TabControl>

                <Border Grid.Row="1" CornerRadius="8" Background="#05080F" BorderBrush="#D4AF37" BorderThickness="1" Padding="0" Margin="0,12,0,0" Height="180" IsVisible="{Binding IsBusy}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#0A1220" CornerRadius="8,8,0,0" Padding="12,8">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Ellipse Width="9" Height="9" Fill="#F87171" />
                                    <Ellipse Width="9" Height="9" Fill="#FBBF24" />
                                    <Ellipse Width="9" Height="9" Fill="#34D399" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="AUDIT TERMINAL" Classes="section-title" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                    <Button Content="Clear" Command="{Binding ClearLogsCommand}" Classes="subtle" Padding="8,4" FontSize="11" />
                                    <Button Content="Export" Command="{Binding ExportLogsCommand}" Classes="subtle" Padding="8,4" FontSize="11" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" Padding="14,8" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Logs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Classes="neon" FontSize="12" Margin="0,1" TextWrapping="Wrap">
                                            <Run Text="&gt; " /><Run Text="{Binding}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border IsVisible="{Binding IsBusy}" CornerRadius="14" Background="#0A1220" BorderBrush="#D4AF37" BorderThickness="1" Padding="28">
                    <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">
                        <TextBlock Text="Running Security Scan" FontSize="19" FontWeight="Bold" Foreground="#F8FAFC" LetterSpacing="1" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding ActiveCheck}" FontSize="15" FontWeight="SemiBold" Foreground="#D4AF37" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#8B9CB8" TextWrapping="Wrap" HorizontalAlignment="Center" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="10" Margin="0,8" />
                        <Border CornerRadius="8" Background="#0D1626" Padding="12" BorderBrush="#1E2B42" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <TextBlock Text="PLANNED CHECKS" Classes="section-title" FontSize="10.5" />
                                <ScrollViewer Height="140">
                                    <ItemsControl ItemsSource="{Binding AuditModules}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="#C7D0E0" Margin="0,2" FontSize="12.5" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border IsVisible="{Binding IsConfirmingUpgrade}" CornerRadius="14" Background="#0A1220" BorderBrush="#D4AF37" BorderThickness="1" Padding="28">
                    <StackPanel Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center" Width="560">
                        <TextBlock Text="Confirm System Changes" FontSize="19" FontWeight="Bold" Foreground="#F8FAFC" LetterSpacing="1" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding UpgradeConfirmationMessage}" Foreground="#DCE4F0" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                            <Button Content="Cancel" Command="{Binding CancelUpgradeCommand}" Classes="subtle" />
                            <Button Content="Yes, Upgrade" Command="{Binding ConfirmUpgradeCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
